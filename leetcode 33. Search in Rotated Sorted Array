class Solution {
    public int searchBin(int[] arr,int lo, int hi, int target){
        while(lo<=hi){
            int mid=(hi-lo)/2+lo;
            if(arr[mid]==target){
                return mid;
            }
            else if(arr[mid]>target){
                hi=mid-1;
            }
            else{
                lo=mid+1;
            }
        }
        return -1;
    }
    public int search(int[] nums, int target) {
        if(nums.length<=2){
            int k=-1;
            //lenear search
            for(int i=0; i<nums.length; i++){
                if(nums[i]==target){
                    k=i;
                    break;
                }
            }
            return k;
        }
        int pivot=-1;
        int lo=1,hi=nums.length-2;
        //identify pivot
        while(lo<=hi){
            int mid=(hi-lo)/2+lo;
            if(nums[mid]>nums[mid-1]&&nums[mid]>nums[mid+1]){
                pivot=mid+1;
                break;
            }
            else if(nums[mid]<nums[mid-1]&&nums[mid]<nums[mid+1]){
                pivot=mid;
                break;
            }
            else if(nums[mid]>nums[mid-1] && nums[mid]<nums[mid+1]){
                if(nums[mid]>nums[nums.length-1]){
                    lo=mid+1;
                }
                else{
                    hi=mid-1;
                }
            }
        }
        if(pivot==-1) return searchBin(nums,0,nums.length-1, target);
        int k=searchBin(nums,0,pivot-1, target);
        if(k!=-1) return k;
        return searchBin(nums,pivot,nums.length-1, target);

    }
}
