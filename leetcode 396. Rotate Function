class Solution {
    public int maxRotateFunction(int[] nums) {
       int n=nums.length;
       long sum=0;
       long j=0;
       for(int i=0; i<n; i++){
        sum += nums[i];
        j+=(long)i*nums[i];
       }
       long result=j;
       for(int k=1; k<n; k++){
        j=j+sum-(long)n*nums[n-k];
        result=Math.max(result,j);
       }
       return (int) result;
    }
}
