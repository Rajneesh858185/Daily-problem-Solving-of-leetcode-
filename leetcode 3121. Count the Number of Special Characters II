class Solution {
    public int numberOfSpecialChars(String word) {
        HashMap<Character,List<Integer>> h=new HashMap<>();
        for(int i=0; i<word.length(); i++){
            if(h.containsKey(word.charAt(i))){
                h.get(word.charAt(i)).add(i);
            }
            else{
                List<Integer> l=new ArrayList<>();
                l.add(i);
                h.put(word.charAt(i),l);
            }
        }
        int ans=0;
        for(int i=0; i<26; i++){
            char ch=(char)(i+97);
            char sh=(char)(i+65);
            if(h.containsKey(ch) && h.containsKey(sh)){
                    List<Integer> m=h.get(ch);
                    List<Integer> n=h.get(sh);
                    if(m.get(m.size()-1)<n.get(0)) ans++;
            }
        }
        return ans;
    }
}
